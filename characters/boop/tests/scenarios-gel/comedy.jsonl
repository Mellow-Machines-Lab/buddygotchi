// The gel's comedy (CONTINUITY.md, Comedy), each on a frozen clock after a
// reset (the device wakes in its startup mood, then takes the state's).
// The yawn and the sneeze every mood shares are the face's pastimes: calm,
// asked for each, yawns (a second in: stretched, eyes squeezed) and winds
// up a sneeze. A mood's own gags its bag deals from its second round:
// excited's zoomies come at 43.5 s, at the left edge, then the right. Asleep
// snores from 19.3 s (a breath's swell). A happy finish's sixth take is its
// fourth, the hiccups, at the first; proud's third is its lifted one, with
// the gift. A state every 20 s keeps the link alive.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"calm","vol":0}
{"clock":20000}
{"t":"state","base":"idle","mood":"calm","vol":0}
{"clock":40000}
{"t":"state","base":"idle","mood":"calm","vol":0}
{"clock":41800}
{"t":"dbg.pastime","name":"yawn-and-settle"}
{"clock":42800}
{"expect":{"mood":"calm","base":"idle","moment":null}}
{"shot":"yawn"}
{"clock":51800}
{"t":"dbg.pastime","name":"sneeze-and-shake"}
{"clock":52640}
{"shot":"sneeze"}
