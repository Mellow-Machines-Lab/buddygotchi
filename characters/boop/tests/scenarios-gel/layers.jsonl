// What the gel wears and the air around it, by the tags on
// (render/gel/layers.h), each on a frozen clock after a reset, idle unless
// it says. A state every 20 s keeps the link alive.
// A night: the moon and stars behind it, a striped nightcap flopping
// down its side and the pyjamas to match, its lids a little lower.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"calm","vol":0,"when":["night"]}
{"clock":1200}
{"shot":"nightcap"}
// Asleep at night: the nightcap and its pyjamas, and Zs rising; and on a
// winter's night, night's cap and pyjamas over winter's bobble, in the
// snow.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"asleep","mood":"calm","vol":0,"when":["night"]}
{"clock":2000}
{"shot":"asleep-night"}
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"asleep","mood":"happy","vol":0,"when":["night","winter"]}
{"clock":3200}
{"shot":"pyjamas"}
// A morning: the sun up on its left and its coffee at its side,
// steaming; lifted to its mouth for a sip (the last 1.8 s of every 9);
// and on the desk beside the keyboard while it works.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"calm","vol":0,"when":["morning"]}
{"clock":4200}
{"shot":"coffee"}
{"clock":7800}
{"shot":"coffee-sip"}
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"working","mood":"determined","vol":0,"busy":1,"when":["morning"]}
{"clock":1500}
{"shot":"coffee-working"}
// Reading glasses while the latest prompt was an essay or for docs, over
// working's face; on a Friday they're worn in place of the shades, and at
// Halloween under the witch hat.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"working","mood":"determined","vol":0,"busy":1,"when":["day","reading"]}
{"clock":1500}
{"shot":"glasses"}
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"proud","vol":0,"when":["day","friday","reading"]}
{"clock":1200}
{"shot":"glasses-friday"}
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"curious","vol":0,"when":["evening","halloween","reading"]}
{"clock":1200}
{"shot":"glasses-halloween"}
// A party day: a party hat and confetti.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"working","mood":"happy","vol":0,"busy":1,"when":["day","party"]}
{"clock":1500}
{"shot":"party"}
// Halloween: a witch hat.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"curious","vol":0,"when":["evening","halloween"]}
{"clock":1200}
{"shot":"halloween"}
// Winter: a bobble hat in the snow.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"happy","vol":0,"when":["morning","winter"]}
{"clock":1200}
{"shot":"winter"}
// A Friday's day: shades. Valentine's: hearts.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"proud","vol":0,"when":["day","friday"]}
{"clock":1200}
{"shot":"friday"}
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"pleased","vol":0,"when":["day","valentines"]}
{"clock":1200}
{"shot":"valentines"}
// A sign at night: held at its front, under the nightcap.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"calm","vol":0,"when":["night"]}
{"clock":1000}
{"t":"do","name":"react","play":"now","args":{"sign":"still broken","mood":"sad"}}
{"clock":1600}
{"shot":"sign-night"}
