// The work stream on the gel (render/gel/stream.h): two agents' lanes, each
// in its colour, each new call's word falling behind the body, the
// to-do list along the monitor's foot and the turn's clock in its corner; then
// each gag a word that comes forward plays as it lands. One run on a frozen
// clock after a reset, the state sent again every 20 s as the Mac does.
{"t": "dbg.reset"}
{"clock": 0}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 1, "grep"], [1, 1, "edit +18"]]}
{"clock": 400}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 3, "sed"], [1, 2, "git log"]]}
{"clock": 900}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 4, "python"], [1, 3, "rg"]]}
{"expect": {"calls": 2}}
{"clock": 1500}
{"shot": "falling"}
// A turn's first call drops in, twinkling.
{"clock": 1600}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "grep", "as": "arrive"}}
{"expect": {"call": "arrive"}}
{"clock": 2270}
{"shot": "arrive"}
// A failed command flies at its face: dizzy eyes, stars.
{"clock": 4500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "make", "as": "bonk"}}
{"clock": 4700}
{"shot": "bonk-flying"}
{"clock": 5200}
{"shot": "bonk-dizzy"}
// Up the ladder: a helmet.
{"clock": 7500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "swift", "as": "helmet"}}
{"clock": 8200}
{"shot": "helmet"}
// A lookup that found nothing: a shrug and an empty bubble.
{"clock": 10500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "grep", "as": "shrug"}}
{"clock": 11300}
{"shot": "shrug"}
// A big deletion bursts and is swallowed.
{"clock": 13500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "-400", "as": "shatter"}}
{"clock": 14100}
{"shot": "shatter"}
// Tests pass: confetti, and a tick on the monitor.
{"clock": 16500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "PASS", "as": "pass"}}
{"clock": 17100}
{"shot": "pass"}
// Failing tests rain on it; the umbrella comes too late.
{"clock": 19500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "FAIL", "as": "hail"}}
{"clock": 20000}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 4, "python"], [1, 3, "rg"]]}
{"clock": 20500}
{"shot": "hail"}
// A lookup, read through a magnifier; the monitor's page scrolls.
{"clock": 22500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "rg", "as": "look"}}
{"clock": 23300}
{"shot": "look"}
// A script, stirred into a pot.
{"clock": 25500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "python", "as": "stir"}}
{"clock": 26400}
{"shot": "stir"}
// A commit, stamped.
{"clock": 28500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "git commit", "as": "stamp"}}
{"clock": 29400}
{"shot": "stamp"}
// A push, off on a rocket.
{"clock": 31500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "git push", "as": "launch"}}
{"clock": 32700}
{"shot": "launch"}
// A deletion of files: gone in a puff.
{"clock": 34500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "rm", "as": "poof"}}
{"clock": 35050}
{"shot": "poof"}
// The web: a paper plane, caught; a globe on the monitor.
{"clock": 37500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "curl", "as": "plane"}}
{"clock": 37850}
{"shot": "plane-flying"}
{"clock": 38300}
{"shot": "plane-caught"}
{"clock": 40000}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 4, "python"], [1, 3, "rg"]]}
// An MCP tool: a phone ringing.
{"clock": 40500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "linear", "as": "phone"}}
{"clock": 41100}
{"shot": "phone"}
// A doc: a page, its corner turning.
{"clock": 43500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "docs", "as": "page"}}
{"clock": 44100}
{"shot": "page"}
// A helper's word lands like any other.
{"clock": 46500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "helper", "as": "helper"}}
{"clock": 47400}
{"shot": "helper"}
// And so does its return's.
{"clock": 49500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "done", "as": "back"}}
{"clock": 49900}
{"shot": "back"}
// A run of the same: its count.
{"clock": 52500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "sed", "as": "combo", "n": 10}}
{"clock": 52900}
{"shot": "combo"}
// A build: its bricks stack up.
{"clock": 55500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "build", "as": "stack"}}
{"clock": 56800}
{"shot": "stack"}
// Built: a flag on top.
{"clock": 58500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "built", "as": "built"}}
{"clock": 59000}
{"shot": "built"}
{"clock": 60000}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 4, "python"], [1, 3, "rg"]]}
// A failing build: the tower comes down on it.
{"clock": 61500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "FAIL", "as": "topple"}}
{"clock": 62000}
{"shot": "topple-wobble"}
{"clock": 62700}
{"shot": "topple-fallen"}
// An edit sinks in; the monitor shows its lines.
{"clock": 64500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "edit +18 -2", "as": "land"}}
{"clock": 65000}
{"shot": "edit"}
// No new call for 20 s: a thought cloud. The clock says how long they've worked.
{"clock": 67500}
{"shot": "thinking"}
// The whole turn's moments, each over the words falling as it comes.
// A compaction: the words squashed into a cube that drops onto the desk.
{"clock": 68000}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 6, "python"], [1, 5, "rg"]]}
{"clock": 68600}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "context", "as": "compact"}}
{"clock": 68900}
{"shot": "compact-squash"}
{"clock": 69700}
{"shot": "compact-cube"}
// A rate limit: the words freeze where they are, icy.
{"clock": 71500}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 8, "python"], [1, 7, "rg"]]}
{"clock": 71900}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "rate limit", "as": "freeze"}}
{"clock": 72800}
{"shot": "freeze"}
// You stopped it: the words drop, switched off.
{"clock": 74500}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 10, "python"], [1, 9, "rg"]]}
{"clock": 74800}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "stopped", "as": "drop"}}
{"clock": 75100}
{"shot": "drop"}
// Its context ran out: buried in bricks of its words, to its eyes.
{"clock": 77500}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 12, "python"], [1, 11, "rg"]]}
{"clock": 77800}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "context full", "as": "buried"}}
{"clock": 79200}
{"shot": "buried"}
// The turn's done: the stream goes, its words linger, and it gathers them up.
{"clock": 81000}
{"t": "state", "base": "working", "act": "terminal", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 14, "python"], [1, 13, "rg"]]}
{"clock": 81300}
{"t": "state", "base": "idle", "mood": "engaged", "busy": 0, "idle": 2, "vol": 0, "when": ["day"]}
{"clock": 81350}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "done", "as": "gather"}}
{"expect": {"call": "gather", "calls": 0}}
{"clock": 81750}
{"shot": "gather"}
{"clock": 82300}
{"shot": "gather-mm"}
// Something needs you: the stream goes.
{"clock": 84000}
{"t": "state", "base": "working", "mood": "engaged", "busy": 2, "vol": 0, "when": ["day"], "attn": {"agent": "claude", "project": "landing", "more": 0, "id": 7}}
{"expect": {"calls": 0, "call": null}}
// One lane at night: its words on the left, clear of the nightcap.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"working","act":"terminal","mood":"engaged","busy":1,"vol":0,"when":["night"],"calls":[[0, 1, "grep"]]}
{"clock":500}
{"t":"state","base":"working","act":"terminal","mood":"engaged","busy":1,"vol":0,"when":["night"],"calls":[[0, 3, "git log"]]}
{"clock":1400}
{"shot":"one-lane-night"}
