// The work stream on the gel (render/gel/stream.h): two agents' lanes, the
// newest call's word after the strip's count, nothing falling; then what
// each word that comes forward from the monitor does as it lands. One run on a frozen
// clock after a reset, the state sent again every 20 s as the Mac does.
{"t": "dbg.reset"}
{"clock": 0}
{"t": "state", "base": "working", "mood": "focused", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 1, "grep"], [1, 1, "edit +18"]]}
{"clock": 400}
{"t": "state", "base": "working", "mood": "focused", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 3, "sed"], [1, 2, "git log"]]}
{"clock": 900}
{"t": "state", "base": "working", "mood": "focused", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 4, "python"], [1, 3, "rg"]]}
{"expect": {"calls": 2}}
{"clock": 1500}
{"shot": "falling"}
// A failed command flies at its face: dizzy eyes, stars.
{"clock": 4500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "make", "as": "bonk"}}
{"clock": 4700}
{"shot": "bonk-flying"}
{"clock": 5200}
{"shot": "bonk-dizzy", "pin": true}
// Up the ladder: more stars.
{"clock": 7500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "swift", "as": "bonk3"}}
{"clock": 8200}
{"shot": "bonk3"}
// A lookup that found nothing: its word beside its head, and a shrug.
{"clock": 10500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "grep", "as": "shrug"}}
{"clock": 11300}
{"shot": "shrug"}
// A big deletion bursts and is swallowed.
{"clock": 13500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "-400", "as": "shatter"}}
{"clock": 14100}
{"shot": "shatter"}
// A helper's word lands like any other.
{"clock": 30000}
{"t": "state", "base": "working", "mood": "focused", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 4, "python"], [1, 3, "rg"]]}
{"clock": 46500}
{"t": "state", "base": "working", "mood": "focused", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 4, "python"], [1, 3, "rg"]]}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "helper", "as": "helper"}}
{"clock": 47400}
{"shot": "helper"}
// And so does its return's.
{"clock": 49500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "back", "as": "back"}}
{"clock": 49900}
{"shot": "back"}
// An edit sinks in; the monitor stays as it was.
{"clock": 64500}
{"t": "do", "name": "call", "play": "now", "args": {"a": 1, "w": "edit +18 -2", "as": "land"}}
{"clock": 65000}
{"shot": "edit", "pin": true}
// No new call for 20 s: nothing comes up beside it or on the monitor.
{"clock": 67500}
{"shot": "quiet"}
// The whole turn's moments, each over the words falling as it comes.
// You stopped it, or it failed (a rate limit, a full context): the words
// drop, switched off.
{"clock": 74500}
{"t": "state", "base": "working", "mood": "focused", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 10, "python"], [1, 9, "rg"]]}
{"clock": 74800}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "stopped", "as": "drop"}}
{"clock": 75100}
{"shot": "drop"}
// The turn's done: the stream goes, its words linger, and it gathers them up.
{"clock": 81000}
{"t": "state", "base": "working", "mood": "focused", "busy": 2, "vol": 0, "when": ["day"], "todo": {"done": 3, "total": 7}, "calls": [[0, 14, "python"], [1, 13, "rg"]]}
{"clock": 81300}
{"t": "state", "base": "idle", "mood": "focused", "busy": 0, "idle": 2, "vol": 0, "when": ["day"]}
{"clock": 81350}
{"t": "do", "name": "call", "play": "now", "args": {"a": 0, "w": "done", "as": "gather"}}
{"expect": {"call": "gather", "calls": 0}}
{"clock": 81750}
{"shot": "gather"}
{"clock": 82300}
{"shot": "gather-mm"}
// Something needs you: the stream goes.
{"clock": 84000}
{"t": "state", "base": "working", "mood": "focused", "busy": 2, "vol": 0, "when": ["day"], "attn": {"agent": "claude", "project": "landing", "more": 0, "id": 7}}
{"expect": {"calls": 0, "call": null}}
// One lane at night: its words on the left.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"working","mood":"focused","busy":1,"vol":0,"when":["night"],"calls":[[0, 1, "grep"]],"energy":"tired"}
{"clock":500}
{"t":"state","base":"working","mood":"focused","busy":1,"vol":0,"when":["night"],"calls":[[0, 3, "git log"]],"energy":"tired"}
{"clock":1400}
{"shot":"one-lane-night"}
