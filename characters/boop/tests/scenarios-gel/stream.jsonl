// The work stream on the gel (render/gel/stream.h): two agents' lanes,
// their names along the top and each new call's word falling behind the
// body, then words that come forward and what the body does as each lands.
// Each on a frozen clock after a reset.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"working","act":"terminal","mood":"engaged","busy":2,"vol":0,"when":["day"],"calls":[[0,1,"grep","buddygotchi"],[1,1,"edit +18","landing"]]}
{"clock":400}
{"t":"state","base":"working","act":"terminal","mood":"engaged","busy":2,"vol":0,"when":["day"],"calls":[[0,3,"sed","buddygotchi"],[1,2,"git log","landing"]]}
{"clock":900}
{"t":"state","base":"working","act":"terminal","mood":"engaged","busy":2,"vol":0,"when":["day"],"calls":[[0,4,"python","buddygotchi"],[1,3,"rg","landing"]]}
{"expect":{"calls":2}}
{"clock":1500}
{"shot":"falling"}
// A failed command flies at its face: it lands, and the stars go round.
{"t":"do","name":"call","play":"now","args":{"a":1,"w":"make","as":"bonk"}}
{"expect":{"call":"bonk"}}
{"clock":1700}
{"shot":"bonk-flying"}
{"clock":2200}
{"shot":"bonk-dazed"}
// Up the ladder: a helmet.
{"clock":4500}
{"t":"do","name":"call","play":"now","args":{"a":1,"w":"swift","as":"helmet"}}
{"clock":5200}
{"shot":"helmet"}
// A lookup that found nothing: a shrug and an empty bubble.
{"clock":7500}
{"t":"do","name":"call","play":"now","args":{"a":0,"w":"grep","as":"shrug"}}
{"clock":8300}
{"shot":"shrug"}
// A big deletion bursts and is swallowed.
{"clock":10500}
{"t":"do","name":"call","play":"now","args":{"a":0,"w":"-400","as":"shatter"}}
{"clock":11100}
{"shot":"shatter"}
// The tests pass: confetti, and a tick on the monitor.
{"clock":13500}
{"t":"do","name":"call","play":"now","args":{"a":0,"w":"PASS","as":"pass"}}
{"clock":14100}
{"shot":"pass"}
// Failing tests rain on it.
{"clock":16500}
{"t":"do","name":"call","play":"now","args":{"a":1,"w":"FAIL","as":"hail"}}
{"clock":17000}
{"shot":"hail"}
// Something needs you: the stream goes, and a call is refused.
{"clock":19500}
{"t":"state","base":"working","mood":"engaged","busy":2,"vol":0,"when":["day"],"attn":{"agent":"claude","project":"landing","more":0,"id":7}}
{"expect":{"calls":0}}
