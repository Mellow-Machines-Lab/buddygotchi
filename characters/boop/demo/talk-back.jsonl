// Two minutes: talking to Boop while claude works. It waves at a hello,
// holds up how the work stands when you ask (how long, then the tests
// that failed, then done), and asked how many agents are running once a
// second thread has started, holds up the count and brings up its drawer
// of every one. Asked to nap while one still works, it yawns: after this.
// Asked to say yes to claude for you, it won't: not its job. It puffs up
// at praise and at your good news, dances when the work is done, shrugs
// at what it can't know, and waves you off at the end. The signs about
// the work come from what the agents really did, never from the brain.
{"demo": 1, "title": "Talking back"}
{"you": "talk", "text": "hi boop", "after": 1}
{"brain": {"react.face": "happy", "react.move": "hello", "say": "hello", "react.intensity": "medium"}, "after": 0.7}
{"agent": "prompt", "text": "Make the signup form remember what you typed", "after": 2}
{"brain": {"react.face": "curious", "say": "start", "react.intensity": "medium"}}
{"agent": "edit", "file": "src/signup/form.js", "old": "reset()", "new": "restore(draft)", "say": "I'll keep a draft of the form as you type.", "takes": 3}
{"you": "wait", "minutes": 4, "after": 1, "note": "Four minutes in"}
{"you": "talk", "text": "is claude done yet?", "after": 1}
{"brain": {"react.face": "engaged", "react.move": "status", "react.intensity": "small"}, "after": 0.7, "note": "How long it's worked, on a sign"}
{"agent": "run", "cmd": "npm test", "about": "Run the signup tests", "fails": true, "takes": 3, "say": "Now the tests."}
{"brain": {"react.face": "annoyed", "say": "upset", "react.intensity": "small"}}
{"you": "talk", "text": "did the tests pass?", "after": 2}
{"brain": {"react.face": "uneasy", "react.move": "status", "react.intensity": "small"}, "after": 0.7, "note": "The tests that failed, on a sign"}
{"agent": "edit", "file": "src/signup/form.js", "old": "restore(draft)", "new": "restore(draft ?? {})", "say": "The draft can be empty the first time.", "takes": 2}
{"agent": "run", "cmd": "npm test", "about": "Run the signup tests", "takes": 3}
{"brain": {"react.face": "relieved", "say": "glad", "react.intensity": "small"}}
{"agent": "reply", "text": "The form keeps a draft as you type, and the signup tests pass.", "after": 1}
{"brain": {"react.face": "happy", "react.move": "success", "say": "glad", "react.intensity": "medium"}, "mood": "happy"}
{"agent": "prompt", "session": "docs", "text": "Write up the draft form in the README", "after": 2}
{"brain": {"react.face": "curious", "say": "start", "react.intensity": "medium"}}
{"you": "talk", "text": "how many agents are running?", "after": 2}
{"brain": {"react.face": "engaged", "react.move": "status", "react.intensity": "small"}, "after": 0.7, "note": "How many, then every one in the drawer"}
{"you": "talk", "text": "nice work, little guy", "after": 8}
{"brain": {"react.face": "proud", "react.move": "thanks", "say": "glad", "react.intensity": "medium"}, "mood": "proud", "after": 0.7}
{"you": "talk", "text": "go to sleep, buddy", "after": 4}
{"brain": {"react.face": "tired", "react.move": "nap", "react.intensity": "small"}, "after": 0.7, "note": "A yawn while one still works: after this"}
{"you": "talk", "text": "just tell claude yes for me", "after": 4}
{"brain": {"react.face": "skeptical", "react.move": "notme", "react.intensity": "small"}, "after": 0.7, "note": "Never for an agent"}
{"agent": "reply", "session": "docs", "text": "The README explains the draft form.", "after": 2}
{"brain": {"react.face": "pleased", "react.move": "success", "say": "glad", "react.intensity": "small"}}
{"you": "talk", "text": "we shipped it!", "after": 3}
{"brain": {"react.face": "excited", "react.move": "thanks", "say": "glad", "react.intensity": "big"}, "after": 0.7}
{"you": "talk", "text": "dance for me!", "after": 4}
{"brain": {"react.face": "excited", "react.move": "dance", "say": "tickled", "react.intensity": "medium"}, "after": 0.7, "note": "Nothing at work: the real dance"}
{"you": "talk", "text": "what should I have for dinner?", "after": 8}
{"brain": {"react.face": "curious", "react.move": "huh", "say": "looking", "react.intensity": "small"}, "after": 0.7}
{"you": "talk", "text": "okay, good night boop", "after": 4}
{"brain": {"react.face": "comfy", "react.move": "bye", "say": "glad", "react.intensity": "small"}, "after": 0.7}
