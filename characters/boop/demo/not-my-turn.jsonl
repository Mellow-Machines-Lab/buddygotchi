// Two buddies, one desk: Pixel on the left watches Claude, Boop on the
// right watches Codex. Claude's turn goes well and Codex's tests fail;
// Pixel celebrates while Boop sulks and you poke it, until Codex gets its
// own turn right. Each buddy reacts to its own agent first, then to the
// other buddy.
{"demo": 1, "title": "Not my turn", "buddies": [{"place": "left", "pack": "pixel", "agents": ["claude"]}, {"place": "right", "pack": "boop", "agents": ["codex"]}]}
{"agent": "prompt", "buddy": "left", "text": "Add a dark mode toggle"}
{"brain": {"react.face": "curious", "say": "start", "react.intensity": "medium"}, "buddy": "left"}
{"agent": "prompt", "buddy": "right", "text": "Fix the flaky login test"}
{"brain": {"react.face": "determined", "say": "start", "react.intensity": "medium"}, "buddy": "right"}
{"agent": "read", "buddy": "left", "file": "src/theme.css", "say": "Let me look at the theme first."}
{"agent": "run", "buddy": "right", "cmd": "npm test", "about": "Run the tests", "fails": true, "takes": 1.5}
{"brain": {"react.face": "annoyed", "say": "upset", "react.intensity": "medium"}, "mood": "annoyed", "buddy": "right"}
{"brain": {"react.face": "amused", "say": "tickled", "react.intensity": "small"}, "buddy": "left", "after": 0.8}
{"you": "poke", "buddy": "right", "after": 1.2}
{"brain": {"react.face": "grumpy", "say": "upset", "react.intensity": "small"}, "mood": "grumpy", "buddy": "right"}
{"agent": "edit", "buddy": "left", "file": "src/theme.css", "old": ":root {", "new": ":root[data-theme=dark] {"}
{"agent": "reply", "buddy": "left", "text": "Dark mode is in, with a toggle in the header."}
{"brain": {"react.face": "excited", "react.move": "success", "react.intensity": "big", "say": "glad"}, "mood": "proud", "buddy": "left"}
{"brain": {"react.face": "disappointed", "say": "upset", "react.intensity": "small"}, "buddy": "right", "after": 1, "note": "Not my turn"}
{"agent": "edit", "buddy": "right", "file": "test/login.test.js", "old": "await sleep(100)", "new": "await screen.findByText('Welcome')"}
{"agent": "run", "buddy": "right", "cmd": "npm test", "about": "Run the tests", "takes": 1.5}
{"agent": "reply", "buddy": "right", "text": "The login test waits for the page now, and passes."}
{"brain": {"react.face": "proud", "react.move": "success", "react.intensity": "medium", "say": "glad"}, "mood": "proud", "buddy": "right"}
{"brain": {"react.face": "happy", "say": "glad", "react.intensity": "small"}, "buddy": "left", "after": 1}
