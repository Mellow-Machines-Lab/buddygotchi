{"agent": "edit", "file": "src/useShortcuts.js", "old": "// Keyboard shortcuts for the editor.\nfunction useShortcuts(editor, doc) {\n  // TODO: Mod+K opens the command menu and / opens search, without getting\n  // in the way of typing.\n  return () => {};\n}", "new": "const EDITABLE = new Set([\"true\", \"plaintext-only\"]);\n\n// Whether a key lands somewhere the person types: an input, a textarea or\n// an editable block.\nfunction isTyping(target) {\n  const tag = (target.tagName || \"\").toLowerCase();\n  return tag === \"input\" || tag === \"textarea\" || EDITABLE.has(target.contentEditable);\n}\n\n// Keyboard shortcuts for the editor: Mod+K opens the command menu from\n// anywhere, and / opens search unless you're typing. Keys an input method\n// is still composing are left alone.\nfunction useShortcuts(editor, doc) {\n  function onKeyDown(event) {\n    if (event.isComposing) return;\n    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === \"k\") {\n      event.preventDefault();\n      editor.openMenu();\n    } else if (event.key === \"/\" && !isTyping(event.target)) {\n      event.preventDefault();\n      editor.openSearch();\n    }\n  }\n  doc.addEventListener(\"keydown\", onKeyDown);\n  return () => doc.removeEventListener(\"keydown\", onKeyDown);\n}", "after": 2, "takes": 1.5, "say": "I'll add one keydown listener: Mod+K opens the menu from anywhere, and / opens search unless you're typing."}
