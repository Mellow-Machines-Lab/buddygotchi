# The world server's environment. Vercel sets these in the project; for a
# local run against a real database, `npx vercel env pull .env.local`.
# With DATABASE_URL unset, the server runs on PGlite in memory.
DATABASE_URL=
ADMIN_TOKEN=
CRON_SECRET=
# The salt for IP addresses' hashes, for the limit on joining. Unset, each
# instance makes a random one, and counts joins on its own.
IP_SALT=
