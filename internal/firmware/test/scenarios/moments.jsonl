// The animations as tools play them (`play` now), at a
// characteristic frame. The finish's success, as the dashboard plays it:
// its `loops` of happy's first task-complete design (6.4 s), one when the
// reaction doesn't say. With `who`, the strip names whose turn it was, after a
// tick. (The shots keep the older names they were first taken under:
// `cheer` for the success.) A tap's poke is taps.jsonl's.
{"clock":0}
{"t":"state","base":"idle"}
{"clock":10000}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","variant":1}}
{"clock":10190}
{"expect":{"moment":{"anim":"task_complete","variant":1}}}
{"shot":"cheer"}
{"clock":16399}
{"expect":{"moment":{"anim":"task_complete","left_ms":1}}}
{"clock":16400}
{"expect":{"moment":null}}
{"t":"state","base":"idle","busy":2}
{"clock":20000}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","variant":1,"who":{"agent":"codex","thread":"landing-page-redesig.."}}}
{"clock":20190}
{"shot":"cheer_who"}
{"clock":26400}
{"expect":{"moment":null}}
{"t":"state","base":"idle"}
// stop_listening with nothing to stop is skipped: it never ends another
// animation.
{"clock":50000}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","variant":1}}
{"clock":50500}
{"t":"do","name":"stop_listening","play":"now"}
{"expect":{"moment":{"anim":"task_complete","left_ms":5900}}}
{"t":"state","base":"idle"}
// The Mac's own listening holds until the reply;
// stop_listening ends it and does nothing else: the face blends back.
{"clock":60000}
{"t":"do","name":"listening","play":"now","args":{"variant":2}}
{"clock":60400}
{"expect":{"moment":{"anim":"listening","left_ms":37600}}}
{"shot":"listening"}
{"t":"state","base":"idle"}
{"clock":65000}
{"t":"do","name":"stop_listening","play":"now"}
{"expect":{"moment":null,"audio":{"playing":false}}}
{"clock":65075}
{"shot":"listening-stopped-75ms"}
{"t":"state","base":"idle"}
// A name the device doesn't have, a removed animation's among them, is
// skipped (unknown).
{"clock":70000}
{"t":"do","name":"oops","play":"now"}
{"expect":{"moment":null}}
{"t":"do","name":"nod","play":"now"}
{"t":"do","name":"thinking","play":"now"}
{"t":"do","name":"shrug","play":"now"}
{"expect":{"moment":null}}
// Two loops: the design plays again from its start, so 190 ms into the
// second loop looks as 190 ms into the first.
{"clock":90000}
{"t":"state","base":"idle"}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","variant":1,"loops":2}}
{"expect":{"moment":{"anim":"task_complete","left_ms":12800}}}
{"clock":96590}
{"expect":{"moment":{"anim":"task_complete","left_ms":6210}}}
{"shot":"cheer-second-loop"}
{"t":"state","base":"idle"}
{"clock":102799}
{"expect":{"moment":{"anim":"task_complete","left_ms":1}}}
{"clock":102800}
{"expect":{"moment":null}}
