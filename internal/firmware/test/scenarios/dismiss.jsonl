{"shot":"holding"}
{"clock":2600}
{"clock":2700}
{"clock":2800}
{"clock":2900}
{"clock":3000}
{"expect":{"screen":"needs_you","last_input":{"k":"gesture","at":3000},"moment":null}}
{"clock":3100}
