// Switching designs: the eyes shut for 150 ms to hide each cut, and a
// switch mid-switch shuts them again from there. Idle's plain face is the
// rig face, so going to work it cross-fades into the design as that blinks
// open.
{"clock":0}
{"t":"state","base":"idle"}
{"clock":1000}
{"t":"state","base":"working","busy":1}
{"clock":1050}
{"shot":"idle-to-working-50ms"}
{"clock":1100}
{"shot":"idle-to-working-100ms"}
{"clock":1150}
{"shot":"idle-to-working-150ms"}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","variant":1}}
{"clock":1225}
{"shot":"to-cheer-75ms"}
{"t":"do","name":"stopped","play":"now"}
{"clock":1300}
{"shot":"interrupted-75ms"}
{"expect":{"moment":{"anim":"stopped","left_ms":4125}}}
// A rule's reaction, happy's 4.2 s stopped: it ends at 5425, and working
// comes back behind a blink.
{"clock":5424}
{"expect":{"moment":{"anim":"stopped","left_ms":1}}}
{"clock":5425}
{"expect":{"moment":null}}
{"clock":5500}
{"shot":"back-to-working-75ms"}
