// Switching designs: each switch dissolves over 200 ms, and a switch
// mid-switch dissolves from the picture that shows more: working's, 150 ms
// in, then still working's for the start 75 ms into the cheer. Idle's
// plain face is the rig face, and so is working's, so going to work the face
// stays whole as the desk dissolves in around it.
{"clock":0}
{"t":"state","base":"idle"}
{"clock":1000}
{"t":"state","base":"working","busy":1}
{"clock":1050}
{"shot":"idle-to-working-50ms"}
{"clock":1100}
{"shot":"idle-to-working-100ms"}
{"clock":1150}
{"shot":"idle-to-working-150ms"}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","variant":1}}
{"clock":1225}
{"shot":"to-cheer-75ms"}
{"t":"do","name":"starting","play":"now","args":{"ctx":"new_task"}}
{"clock":1300}
{"shot":"to-starting-75ms"}
{"expect":{"moment":{"anim":"starting","left_ms":3725}}}
