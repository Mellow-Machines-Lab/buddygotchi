// Needs you: who, +N more, its performance once per
// needs-you, amber at half until it's answered, then back to the base look.
{"clock":0}
{"t":"state","base":"working","busy":2}
{"clock":1000}
{"t":"state","base":"working","attn":{"agent":"codex","project":"landing","more":0},"busy":1}
{"clock":1100}
{"expect":{"screen":"needs_you","attn":{"agent":"codex","project":"landing"},"led":"#805800","bl":255,"alert":1000}}
// Half way through the dissolve from working's look into the screen.
{"shot":"blend"}
{"clock":1500}
{"shot":"needs-you"}
// The same needs-you again doesn't play it again, and nothing grows.
{"clock":20000}
{"t":"state","base":"working","attn":{"agent":"codex","project":"landing","more":0},"busy":1}
{"clock":40000}
{"t":"state","base":"working","attn":{"agent":"codex","project":"landing","more":1},"busy":1}
{"clock":60000}
{"t":"state","base":"working","attn":{"agent":"codex","project":"landing","more":1},"busy":1}
{"clock":80000}
{"t":"state","base":"working","attn":{"agent":"codex","project":"landing","more":1},"busy":1}
{"clock":100000}
{"t":"state","base":"working","attn":{"agent":"codex","project":"landing","more":1},"busy":1}
{"clock":121000}
{"expect":{"screen":"needs_you","led":"#805800","alert":1000}}
{"shot":"plus-one-more"}
// A different needs-you plays it once more. Its project, a-very-long-project-name,
// comes cut by the Mac to 23 bytes ending "..".
{"t":"state","base":"working","attn":{"agent":"claude","project":"a-very-long-project-n..","more":0},"busy":1}
{"clock":122000}
{"expect":{"alert":121000}}
{"shot":"long-project"}
{"t":"state","base":"working","busy":2}
{"clock":122200}
{"expect":{"screen":"face","attn":null,"moment":null,"led":"#000000"}}
{"shot":"cleared"}
// The thread's name, when the Mac has one, shows in the project's place,
// cut as the project is.
{"t":"state","base":"working","attn":{"agent":"claude","project":"a-very-long-project-n..","name":"Thread name on \"needs..","more":0},"busy":1}
{"clock":123000}
{"expect":{"screen":"needs_you","attn":{"name":"Thread name on \"needs.."},"alert":122200}}
{"shot":"thread-name"}
// The sign: settled, the head peeks over its top-left corner.
{"clock":124200}
{"shot":"sign-left"}
// The longer it waits, the harder it asks: it sways the sign from 5 s,
// shakes it and waves a mitt from 12 s, lowers it and stares from 17 s.
// The Mac sends the same needs-you again now and then, which starts nothing
// over.
{"clock":129200}
{"t":"state","base":"working","attn":{"agent":"claude","project":"a-very-long-project-n..","name":"Thread name on \"needs..","more":0},"busy":1}
{"shot":"sign-sway"}
{"clock":135200}
{"t":"state","base":"working","attn":{"agent":"claude","project":"a-very-long-project-n..","name":"Thread name on \"needs..","more":0},"busy":1}
{"shot":"sign-shake"}
{"clock":140200}
{"t":"state","base":"working","attn":{"agent":"claude","project":"a-very-long-project-n..","name":"Thread name on \"needs..","more":0},"busy":1}
{"shot":"sign-stare"}
// It gives up at 22 s and peeks for good: it ducks at the end of each
// 4.2 s, then peeks over the top-right, then the middle.
{"clock":148300}
{"t":"state","base":"working","attn":{"agent":"claude","project":"a-very-long-project-n..","name":"Thread name on \"needs..","more":0},"busy":1}
{"shot":"sign-ducking"}
{"clock":149000}
{"shot":"sign-right"}
{"clock":153400}
{"t":"state","base":"working","attn":{"agent":"claude","project":"a-very-long-project-n..","name":"Thread name on \"needs..","more":0},"busy":1}
{"shot":"sign-middle"}
// A name as long as the Mac sends, 47 bytes, fills the sign's three lines.
{"t":"state","base":"working","attn":{"agent":"claude","project":"buddygotchi","name":"Thread name on \"needs you\" screen, with a sig..","more":0},"busy":1}
{"clock":155800}
{"expect":{"screen":"needs_you","attn":{"name":"Thread name on \"needs you\" screen, with a sig.."},"alert":153400}}
{"shot":"sign-long-name"}
