// Device behaviour: press feedback, gestures, and the
// needs-you tap. Shots are the rows' goldens.
{"clock":0}
{"t":"state","base":"idle","busy":0}
{"clock":500}
{"input":{"press":"tap"}}
{"clock":516}
{"expect":{"moment":null,"boot":true}}
{"shot":"press-feedback"}
{"clock":600}
{"expect":{"moment":{"anim":"poked","left_ms":2800},"last_input":{"k":"tap","at":600}}}
{"clock":850}
{"shot":"tap-poked"}
// Holding BOOT 400 ms is push-to-talk: listening shows at once.
{"clock":2000}
{"input":{"press":"hold","ms":1500}}
{"clock":2399}
{"expect":{"moment":{"anim":"poked"},"boot":true,"last_input":{"k":"tap","at":600}}}
{"clock":2400}
{"expect":{"moment":{"anim":"listening"},"last_input":{"k":"talk_on","at":2400}}}
{"clock":2700}
{"shot":"listening"}
// Released: the same listening face waits at most 8 s for the reply, then
// blends back with nothing else.
{"clock":3500}
{"expect":{"moment":{"anim":"listening","left_ms":8000},"boot":false,"last_input":{"k":"talk_off","at":3500}}}
{"t":"state","base":"idle","busy":0}
// A finish meanwhile doesn't replace it.
{"clock":4000}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success"}}
{"expect":{"moment":{"anim":"listening","left_ms":7500}}}
{"clock":11499}
{"expect":{"moment":{"anim":"listening","left_ms":1}}}
{"clock":11500}
{"expect":{"moment":null}}
{"clock":11575}
{"shot":"no-reply-75ms"}
{"t":"state","base":"idle","busy":0}
// A touch held however long is a tap, sent on release.
{"clock":14000}
{"input":{"touch":[160,100],"ms":900}}
{"clock":14899}
{"expect":{"moment":null,"touch":{"down":true},"last_input":{"k":"touch","at":14000}}}
{"clock":14900}
{"expect":{"moment":{"anim":"poked"},"last_input":{"k":"tap","at":14900}}}
{"t":"state","base":"working","busy":1}
{"clock":27000}
{"t":"state","base":"working","attn":{"agent":"codex","project":"landing","more":0},"busy":1}
{"expect":{"screen":"needs_you","led":"#805800","bl":255,"alert":27000}}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","variant":1}}
{"expect":{"moment":null}}
// A tap while something needs you: the press dip only.
{"clock":28000}
{"input":{"touch":[160,70]}}
{"clock":28100}
{"expect":{"screen":"needs_you","moment":null,"last_input":{"k":"tap","at":28100}}}
// The strip is part of the screen: a touch there dips the face and taps.
{"clock":29000}
{"input":{"touch":[160,222]}}
{"clock":29016}
{"shot":"strip-press"}
{"clock":29100}
{"expect":{"screen":"needs_you","moment":null,"last_input":{"k":"tap","at":29100}}}
// Push-to-talk still works while something needs you.
{"clock":29200}
{"input":{"press":"hold","ms":600}}
{"clock":29600}
{"expect":{"screen":"needs_you","moment":{"anim":"listening"},"last_input":{"k":"talk_on","at":29600}}}
{"clock":29760}
{"shot":"needs-you-listening"}
// A `say` can't play while something needs you, but as the reply it
// ends listening.
{"clock":29900}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"previous.go"}}}
{"expect":{"screen":"needs_you","moment":null,"audio":{"take":null}}}
// Answered on the Mac: the needs-you sign cuts back to working.
{"clock":30000}
{"t":"state","base":"working","busy":2}
{"clock":30075}
{"expect":{"screen":"face","attn":null,"moment":null,"led":"#000000"}}
{"shot":"answered-75ms"}
