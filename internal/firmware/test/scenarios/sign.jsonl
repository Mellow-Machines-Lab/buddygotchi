// A reaction's sign: the words held up on a card under the face, from the
// reaction's start for as long as it plays, and at least 2.5 s. Cut past
// 18 glyphs at a word with "..", and accents folded as the fonts draw
// them. A state now and then keeps the link alive.
{"clock":0}
{"t":"state","base":"idle","mood":"happy"}
{"clock":1000}
{"t":"do","name":"react","play":"now","args":{"sign":"bye bye code"}}
{"expect":{"moment":null,"sign":"bye bye code"}}
{"clock":1600}
{"shot":"short"}
// A sign on its own shows 2.5 s.
{"clock":3499}
{"expect":{"sign":"bye bye code"}}
{"clock":3500}
{"expect":{"sign":null}}
// Too long for one card: cut at its last word within 16 glyphs, and "..",
// in the large font.
{"clock":5000}
{"t":"do","name":"react","play":"now","args":{"sign":"  still broken after all of that  "}}
{"expect":{"sign":"still broken.."}}
{"clock":5600}
{"shot":"cut"}
// Accents fold, and "·" stays.
{"clock":10000}
{"t":"do","name":"react","play":"now","args":{"sign":"café · naïve"}}
{"expect":{"sign":"cafe · naive"}}
{"clock":10600}
{"shot":"folded"}
// Over a finish with a `say`: the sign stays up as long as the finish
// plays, the bubble in the lane under it.
{"clock":20000}
{"t":"state","base":"idle","mood":"happy"}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","variant":1,"say":{"take":"new.d14"},"sign":"ship it!"}}
{"expect":{"moment":{"anim":"task_complete"},"sign":"ship it!"}}
{"clock":23000}
{"expect":{"audio":{"take":"new.d14"}}}
{"shot":"over-cheer"}
{"clock":26399}
{"expect":{"moment":{"anim":"task_complete"},"sign":"ship it!"}}
{"clock":26400}
{"t":"state","base":"idle","mood":"happy"}
{"expect":{"moment":null,"sign":null}}
// A tap pokes under the sign, which stays up.
{"clock":30000}
{"t":"state","base":"idle","mood":"happy"}
{"t":"do","name":"react","play":"now","args":{"sign":"hello","mood":"excited"}}
{"input":{"touch":[160,100]}}
{"clock":30300}
{"expect":{"moment":{"anim":"poked"},"sign":"hello"}}
// Needs you takes it down.
{"t":"state","base":"idle","mood":"happy","attn":{"agent":"claude","project":"x","more":0}}
{"expect":{"sign":null}}
