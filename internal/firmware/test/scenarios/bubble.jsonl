// The bubble: the take's text in amber, centred in its box. A `say` on its
// own plays over whatever face is showing: here, working.
{"clock":0}
{"t":"state","base":"working","busy":1}
{"clock":1000}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"previous.go"}}}
{"expect":{"moment":null,"audio":{"playing":true,"take":"previous.go"}}}
{"clock":1400}
{"shot":"short"}
{"clock":10000}
{"t":"state","base":"working","busy":1}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"previous.tsk"}}}
{"clock":10400}
{"shot":"dots"}
{"clock":20000}
{"t":"state","base":"working","busy":1}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"previous.eh"}}}
{"clock":20300}
{"shot":"question"}
// The longest text, whole inside the bubble.
{"clock":30000}
{"t":"state","base":"working","busy":1}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"new.d15"}}}
{"clock":30400}
{"shot":"longest"}
// Its take's 1845 ms, then 1.2 s to read it.
{"clock":33044}
{"expect":{"audio":{"take":"new.d15"}}}
{"clock":33045}
{"expect":{"moment":null,"audio":{"playing":false,"take":null}}}
{"clock":34000}
{"shot":"bubble-gone"}
// A `say` of two takes: both words, one after the other.
{"clock":35000}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"previous.tsk","then":"phase1.word.test.validate__annoyed__contained"}}}
{"clock":35400}
{"shot":"two-takes"}
{"expect":{"audio":{"take":"previous.tsk"}}}
// Text too long for the large font, 22 characters: the small one, whole.
{"clock":40000}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"phase1.phrase.setback.technical-difficulties__sad__contained"}}}
{"clock":40400}
{"shot":"small-text"}
// Over an animation, a `say` leaves it playing, and plays at once; the
// bubble blanks the lane, which the first pack's success fills with gold.
{"t":"state","base":"idle"}
{"clock":40000}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","variant":1}}
{"clock":40300}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"new.d14"}}}
{"expect":{"moment":{"anim":"task_complete","left_ms":6100},"audio":{"playing":true,"take":"new.d14"}}}
{"clock":40500}
{"shot":"over-cheer"}
// A `say` with no take, or one the device doesn't have: nothing plays and
// no bubble shows, and the face goes on.
{"t":"state","base":"idle"}
{"clock":55000}
{"t":"do","name":"react","play":"now","args":{"say":{}}}
{"expect":{"moment":null,"audio":{"playing":false,"take":null}}}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"banana"}}}
{"expect":{"moment":null,"audio":{"playing":false,"take":null}}}
// The reply to push-to-talk ends listening's wait, and plays.
{"t":"state","base":"idle"}
{"clock":57000}
{"input":{"press":"hold","ms":600}}
{"clock":57400}
{"expect":{"moment":{"anim":"listening"}}}
{"clock":57600}
{"expect":{"moment":{"anim":"listening","left_ms":8000}}}
{"clock":58000}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"new.d09"}}}
{"expect":{"moment":null,"audio":{"playing":true,"take":"new.d09"}}}
{"clock":58400}
{"shot":"reply-after-talk"}
// Needs you: nothing plays.
{"t":"state","base":"idle","attn":{"agent":"claude","project":"x","more":0}}
{"clock":60000}
{"t":"do","name":"react","play":"now","args":{"say":{"take":"previous.go"}}}
{"expect":{"moment":null,"audio":{"take":null}}}
