// The queue (linkkit/SPEC.md §4), as the Mac plays it: the
// brain's reactions are `next`, the rules' reactions `if_free`. A reaction
// waits for the `say` before it and starts the millisecond that one ends,
// or rests half a second after its bubble while its face holds on; a
// rule's reaction never cuts a `say`, but plays over a face held after one;
// a finish plays to its end, and a reaction that waits past its ttl is
// late. dbg.state's `turn` says which reaction plays and which wait.
{"clock":0}
{"t":"state","base":"idle"}
{"t":"dbg.look","variant":2}
{"clock":1000}
{"t":"do","id":1,"name":"react","play":"next","args":{"say":{"take":"previous.go"}}}
{"clock":1100}
{"t":"do","id":2,"name":"react","play":"next","args":{"say":{"take":"previous.go"},"mood":"proud","loops":2}}
{"expect":{"turn":{"holder":{"id":1,"name":"react","resting":false},"waiting":[{"id":2,"name":"react","left_ms":5000}]}}}
// A rule's reaction while the `say` plays: skipped (busy), so nothing plays.
{"t":"do","id":3,"name":"starting","play":"if_free","args":{"ctx":"new_task"}}
{"expect":{"moment":null,"audio":{"playing":true,"take":"previous.go"},"turn":{"holder":{"id":1}}}}
// The first `say`'s bubble goes at 1000 + 638 + 1200 ms. Nothing of it plays
// after that, so it's done then, and the second reaction starts, in
// proud's face.
{"clock":2837}
{"expect":{"expr":null,"turn":{"holder":{"id":1},"waiting":[{"id":2,"name":"react","left_ms":3263}]}}}
{"clock":2838}
{"expect":{"expr":"proud","audio":{"playing":true,"take":"previous.go"},"turn":{"holder":{"id":2,"name":"react","resting":false},"waiting":[]}}}
// Its `say` over (2838 + 1838 ms), its face holds on, still busy for half a
// second: a rule's reaction then is skipped (busy).
{"clock":4676}
{"expect":{"expr":"proud","audio":{"take":null},"turn":{"holder":{"id":2,"resting":false}}}}
{"t":"do","id":7,"name":"error","play":"if_free"}
{"expect":{"moment":null,"expr":"proud","turn":{"holder":{"id":2}}}}
// Then it rests: a rule's reaction may play now, and the reaction is done.
{"clock":5176}
{"expect":{"expr":"proud","turn":{"holder":{"id":2,"resting":true}}}}
{"t":"do","id":4,"name":"stopped","play":"if_free"}
{"expect":{"moment":{"anim":"stopped"},"expr":null,"turn":{"holder":{"id":4,"name":"stopped","resting":true},"waiting":[]}}}
// A finish never rests: the reaction behind it waits, and past its 5 s
// it's late. The finish ends at 10000 + 6400 ms, and nothing plays.
{"clock":10000}
{"t":"do","id":5,"name":"task_complete","play":"next","args":{"outcome":"success","variant":1}}
{"t":"do","id":6,"name":"react","play":"next","args":{"say":{"take":"previous.go"}}}
{"expect":{"moment":{"anim":"task_complete"},"turn":{"holder":{"id":5,"name":"task_complete","resting":false},"waiting":[{"id":6,"name":"react","left_ms":5000}]}}}
{"clock":15000}
{"expect":{"turn":{"waiting":[{"id":6,"name":"react","left_ms":0}]}}}
{"clock":15001}
{"expect":{"moment":{"anim":"task_complete"},"audio":{"take":null},"turn":{"holder":{"id":5},"waiting":[]}}}
{"clock":16400}
{"expect":{"moment":null,"turn":{"holder":null,"waiting":[]}}}
