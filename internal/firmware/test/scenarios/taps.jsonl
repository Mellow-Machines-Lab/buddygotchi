// A tap plays the mood's poked design once, from its start, dissolving
// in; the third tap in a row, each within 3 s of
// the last, and each after it play tap_spam. Happy has
// one of each, 2.8 s and 3.8 s.
{"clock":0}
{"t":"state","base":"idle"}
{"clock":1000}
{"input":{"press":"tap"}}
{"clock":1100}
{"expect":{"moment":{"anim":"poked","left_ms":2800,"variant":1},"last_input":{"k":"tap","at":1100}}}
{"clock":1175}
{"shot":"poke-75ms"}
{"clock":1600}
{"shot":"poked"}
{"input":{"press":"tap"}}
{"clock":1700}
{"expect":{"moment":{"anim":"poked","left_ms":2800}}}
{"clock":2200}
{"input":{"press":"tap"}}
{"clock":2300}
{"expect":{"moment":{"anim":"tap_spam","left_ms":3800}}}
{"clock":2900}
{"shot":"tap-spam"}
{"input":{"press":"tap"}}
{"clock":3000}
{"expect":{"moment":{"anim":"tap_spam","left_ms":3800}}}
// Played once, the look comes back.
{"clock":6799}
{"expect":{"moment":{"anim":"tap_spam","left_ms":1}}}
{"clock":6800}
{"expect":{"moment":null}}
// 3 s after the last tap, a new run: poked again.
{"clock":6900}
{"t":"state","base":"idle"}
{"input":{"press":"tap"}}
{"clock":7000}
{"expect":{"moment":{"anim":"poked"}}}
// A new mood's barrage: calm's pokes, three of each, one at random, never
// the one it played last. Its designs start from rest, so the shots are
// 1.3 s in.
{"clock":20000}
{"t":"state","base":"working","mood":"calm","busy":1}
{"input":{"press":"tap"}}
{"clock":20100}
{"expect":{"moment":{"anim":"poked"}}}
{"clock":21400}
{"shot":"poked-calm"}
{"input":{"press":"tap"}}
{"clock":21500}
{"expect":{"moment":{"anim":"poked"}}}
{"clock":21550}
{"input":{"press":"tap"}}
{"clock":21650}
{"expect":{"moment":{"anim":"tap_spam"}}}
{"clock":22950}
{"shot":"tap-spam-calm"}
// While something needs you, a tap only dips the face; it counts in the
// run all the same.
{"clock":30000}
{"t":"state","base":"working","busy":1,"attn":{"agent":"codex","project":"landing","more":0}}
{"input":{"press":"tap"}}
{"clock":30100}
{"expect":{"screen":"needs_you","moment":null,"last_input":{"k":"tap","at":30100}}}
// A barrage gets one answer, and the taps after it don't cut it short:
// each tap still plays its poke, drawn in the
// reaction's mood, while the reaction's `say` plays on over it.
{"clock":40000}
{"t":"state","base":"idle"}
{"input":{"press":"tap"}}
{"clock":40100}
{"clock":40600}
{"input":{"press":"tap"}}
{"clock":40700}
{"clock":41200}
{"input":{"press":"tap"}}
{"clock":41300}
{"expect":{"moment":{"anim":"tap_spam"},"expr":null}}
{"t":"do","id":40,"name":"react","play":"now","args":{"say":{"take":"new.d12"},"mood":"grumpy","loops":1}}
{"expect":{"moment":{"anim":"tap_spam"},"expr":"grumpy","audio":{"playing":true,"take":"new.d12"}}}
{"clock":41500}
{"input":{"press":"tap"}}
{"clock":41600}
{"expect":{"moment":{"anim":"tap_spam","left_ms":3800},"expr":"grumpy","audio":{"playing":true,"take":"new.d12"}}}
{"clock":41900}
{"shot":"tap-spam-over-reaction"}
{"input":{"press":"tap"}}
{"clock":42000}
{"expect":{"moment":{"anim":"tap_spam"},"expr":"grumpy","audio":{"take":"new.d12"}}}
// Its `say` is over after the take's 898 ms and 1.2 s to read it.
{"clock":43397}
{"expect":{"expr":"grumpy","audio":{"take":"new.d12"}}}
{"clock":43398}
{"expect":{"audio":{"take":null}}}
