// What the agents are doing (`act`): while working, the
// device draws that state's design in working's place, in the mood, from
// the Mac's variation. A new one starts from its beginning behind a blink:
// a new mood's flip-book shows its own blink step to hide the switch.
{"clock":0}
{"t":"state","base":"working","act":"terminal","busy":1,"variant":1}
{"clock":1500}
{"expect":{"act":"terminal","look_variant":1,"moment":null}}
{"shot":"terminal"}
{"t":"state","base":"working","act":"analyzing","mood":"calm","busy":1,"variant":2}
{"clock":1575}
{"shot":"to-analyzing-calm-75ms"}
{"clock":3000}
{"expect":{"act":"analyzing","mood":"calm","look_variant":2}}
{"shot":"analyzing-calm"}
// One it doesn't know is working's design.
{"t":"state","base":"working","act":"juggling","mood":"calm","busy":1}
{"expect":{"act":null}}
// The rules' one-shots play once in Boop's mood, the
// variation the Mac names when it's one for the call's context, then
// the look comes back behind a blink. Starting a new task, happy, over
// testing: its 3.8 s design.
{"clock":10000}
{"t":"state","base":"working","act":"testing","mood":"happy","busy":1}
{"t":"do","name":"starting","play":"now","args":{"ctx":"new_task"}}
{"expect":{"moment":{"anim":"starting","left_ms":3800,"variant":1}}}
{"clock":11000}
{"shot":"starting-new-task"}
{"clock":13799}
{"expect":{"moment":{"anim":"starting","left_ms":1}}}
{"clock":13800}
{"expect":{"moment":null,"act":"testing"}}
{"clock":13875}
{"shot":"back-to-testing-75ms"}
// A session resumed: carrying on, the continuation's design, whatever
// variation the Mac named.
{"clock":15000}
{"t":"do","name":"starting","play":"now","args":{"variant":1,"ctx":"continuation"}}
{"expect":{"moment":{"anim":"starting","variant":3}}}
// A context compacted mid-work: its own design, again whatever
// variation the Mac named.
{"clock":16000}
{"t":"do","name":"starting","play":"now","args":{"variant":1,"ctx":"compacted"}}
{"expect":{"moment":{"anim":"starting","variant":4}}}
{"clock":17000}
{"shot":"starting-compacted"}
// Stopped, engaged, idle: the Mac's second variation.
{"clock":20000}
{"t":"state","base":"idle","mood":"engaged"}
{"t":"do","name":"stopped","play":"now","args":{"variant":2}}
{"expect":{"moment":{"anim":"stopped","left_ms":5734,"variant":2}}}
{"clock":21000}
{"shot":"stopped-engaged"}
// A failed command, grumpy.
{"clock":30000}
{"t":"state","base":"working","mood":"grumpy","busy":1}
{"t":"do","name":"error","play":"now","args":{"variant":1}}
{"expect":{"moment":{"anim":"error","left_ms":2888}}}
{"clock":31000}
{"shot":"error-grumpy"}
// A helper back, wounded, over delegating.
{"clock":40000}
{"t":"state","base":"working","act":"delegating","mood":"wounded","busy":1}
{"t":"do","name":"helper_return","play":"now","args":{"variant":3}}
{"expect":{"moment":{"anim":"helper_return","left_ms":7410,"variant":3}}}
{"clock":41500}
{"shot":"helper-return-wounded"}
// None plays while something needs you, or while listening waits for the
// reply, which a one-shot never ends.
{"clock":50000}
{"t":"state","base":"working","busy":1,"attn":{"agent":"claude","project":"landing","more":0}}
{"t":"do","name":"error","play":"now","args":{"variant":1}}
{"expect":{"screen":"needs_you","moment":null}}
{"t":"state","base":"working","busy":1}
{"t":"do","name":"listening","play":"now","args":{"variant":1}}
{"t":"do","name":"starting","play":"now","args":{"ctx":"new_task"}}
{"t":"do","name":"helper_return","play":"now"}
{"expect":{"moment":{"anim":"listening"}}}
{"t":"do","name":"stop_listening","play":"now"}
{"expect":{"moment":null}}
